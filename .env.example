UNIHELP_PROVIDER=lmstudio
# Optional override for the selected provider.
UNIHELP_MODEL=
OPENAI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Optional Vertex API key for chat calls. Leave empty to use Google ADC.
GOOGLE_API_KEY=
# Optional embedding model for hybrid handbook search. Leave empty for keyword search only.
UNIHELP_EMBEDDING_MODEL=
UNIHELP_JUDGE_MODEL=gpt-6-luna
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=unihelp

# Copy the exact model ID from LM Studio if using a different model.
UNIHELP_LM_STUDIO_MODEL=qwen/qwen3.5-9b
UNIHELP_LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
UNIHELP_LM_STUDIO_API_KEY=

# Workspace settings. Seed sample reports only into a fresh workspace.
UNIHELP_DB=unihelp.sqlite3
UNIHELP_SEED_SAMPLE=false
UNIHELP_BACKGROUND_WORKER=false
# Optional absolute path to an approved JSON policy pack.
UNIHELP_POLICY_FILE=

# Optional second LM Studio model for transient errors.
UNIHELP_FALLBACK_MODEL=
UNIHELP_REVIEWER_ID=staff
