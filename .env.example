HALL_PROVIDER=lmstudio
# Optional override for the selected provider.
HALL_MODEL=
OPENAI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
HALL_JUDGE_MODEL=google/gemma-4-e4b
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=unihelp

# Copy the exact model ID from LM Studio if using a different model.
HALL_LM_STUDIO_MODEL=qwen/qwen3.5-9b
HALL_LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
HALL_LM_STUDIO_API_KEY=

# Workspace settings. Seed sample reports only into a fresh workspace.
HALL_DB=halldesk.sqlite3
HALL_SEED_SAMPLE=false
HALL_BACKGROUND_WORKER=false
HALL_ENABLE_QUALITY_CHECKS=false
# Optional absolute path to an approved JSON policy pack.
HALL_POLICY_FILE=

# Optional second LM Studio model for transient errors.
HALL_FALLBACK_MODEL=
HALL_REVIEWER_ID=staff
