HALL_PROVIDER=openai
# Optional agent model override. Defaults to gpt-6-luna or gemini-3.1-flash-lite.
HALL_MODEL=
OPENAI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
HALL_JUDGE_MODEL=gpt-6-luna
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=halldesk

# Set HALL_PROVIDER=lmstudio and copy the loaded Gemma model ID from LM Studio.
HALL_LM_STUDIO_MODEL=
HALL_LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
HALL_LM_STUDIO_API_KEY=

# Workspace settings. Seed sample reports only into a fresh workspace.
HALL_DB=halldesk.sqlite3
HALL_SEED_SAMPLE=false
HALL_BACKGROUND_WORKER=false
# Optional absolute path to an approved JSON policy pack.
HALL_POLICY_FILE=
